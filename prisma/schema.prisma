// Datamodell for Bostadsunderlag. Foljer av docs/k6a-faltlista.md.
// Svenska genomgaende, ASCII-translittererat i identifierare. Belopp lagras som
// heltal i oren. Datum lagras som date, aldrig timestamp.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum upplatelseform {
  bostadsratt
  fastighet
}

enum husform {
  villa
  radhus
  kedjehus
}

enum atgardstyp {
  nybyggnad
  planlosning
  nytt_tillagg
  utbytt
}

// Inbjudans livscykel (docs/design.md, "Att bjuda in en delagare").
enum inbjudningsstatus {
  utestaende
  accepterad
  aterkallad
}

enum regelparameterenhet {
  oren
  ar
}

// En person. Speglar Supabase Auth (auth.users). id sätts till auth-anvandarens uuid.
model anvandare {
  id         String       @id @db.Uuid
  epost      String       @unique
  skapad_at  DateTime     @default(now())
  medlemskap medlemskap[]

  // Vem som lade in ett kvitto respektive besvarade en atgards fragor
  // (docs/design.md, "Samagande – medlemskapet"). Bara for visning.
  kostnader_skapade      kostnad[]  @relation("kostnad_skapad_av")
  projekt_klassificerade projekt[]  @relation("projekt_klassificerad_av")
  inbjudningar_skickade  inbjudan[]
}

// Bostaden. Obligatoriskt vid registrering: endast upplatelseform och tilltradesdatum.
model bostad {
  id                        String         @id @default(uuid()) @db.Uuid
  namn                      String?
  adress                    String? // fritext eller vald fran adresstjanst; namn faller tillbaka pa adress i headern
  place_id                  String? // Google Places-id, null vid fritext
  latitud                   Decimal?       @db.Decimal(9, 6) // null vid fritext
  longitud                  Decimal?       @db.Decimal(9, 6) // null vid fritext
  ort                       String? // valfritt; fylls fran valt Places-forslag
  storlek                   Int? // valfritt, boarea i kvadratmeter
  identifiering             String? // foreningens namn (bostadsratt) eller fastighetsbeteckning (fastighet); forsattssidans rad, utelamnas nar tom
  upplatelseform            upplatelseform
  husform                   husform? // rent informativt, styr ingenting
  tilltradesdatum           DateTime       @db.Date
  // De tva bostadsfragorna (produktspec 4.1, 4.6, CLAUDE.md). Fragor om
  // bostaden, inte om atgarden – stalls darfor EN gang, i genomgangen innan
  // forsta hogen klassificeras, aldrig i registreringen. Gar att andra i
  // installningarna efterat.
  //
  // Reparation och underhall raknas aldrig med om bostaden var nybyggd vid
  // forvarvet, utom vid ombildning fran hyresratt – da fanns lagenheten redan
  // och var anvand (produktspec 4.6).
  nybyggd_vid_forvarv       Boolean        @default(false)
  ombildning_fran_hyresratt Boolean        @default(false)
  // Rent tekniskt bokforingsfalt: har de tva fragorna ovan stallts an? Bada
  // falten defaultar till false, som ocksa ar det vanligaste RIKTIGA svaret –
  // utan denna flagga gar "obesvarat" och "besvarat nej" inte att skilja at,
  // och genomgangen skulle inte kunna blockera tills de faktiskt besvarats
  // (produktspec 4.1: "De blockerar genomgangen tills de besvarats").
  bostadsfragor_besvarade   Boolean        @default(false)
  // Vinstberakningens belopp. BigInt, inte Int: Postgres int4 tar slut vid
  // 2147483647 oren (~21,5 miljoner kr) och en villaforsaljning kan ligga hogre.
  kopeskilling              BigInt? // oren
  kopkostnader              BigInt? // oren, stampelskatt/lagfart eller overlatelseavgift
  kapitaltillskott          BigInt? // oren, endast bostadsratt
  uppskov_tidigare          BigInt? // oren, paverkar vinstberakning, inte avdrag
  forsaljningsdatum         DateTime?      @db.Date
  forsaljningspris          BigInt? // oren
  skapad_at                 DateTime       @default(now())

  medlemskap   medlemskap[]
  projekt      projekt[]
  kostnader    kostnad[]
  inbjudningar inbjudan[]
}

// Kopplingen anvandare–bostad. Agarandelen tillhor relationen, inte bostaden.
model medlemskap {
  id           String   @id @default(uuid()) @db.Uuid
  anvandare_id String   @db.Uuid
  bostad_id    String   @db.Uuid
  agarandel    Decimal  @default(100) @db.Decimal(5, 2) // procent
  skapad_at    DateTime @default(now())

  anvandare anvandare @relation(fields: [anvandare_id], references: [id], onDelete: Cascade)
  bostad    bostad    @relation(fields: [bostad_id], references: [id], onDelete: Cascade)

  @@unique([anvandare_id, bostad_id])
}

// Inbjudan till en bostad (docs/design.md, "Att bjuda in en delagare"). Ger
// tillgang till arkivet, ingenting annat: ingen andel, inget datum. Adressen
// binder inbjudan – den kan bara losas in av den som ar inloggad med exakt
// den adressen. Id:t i lanken ar ingen nyckel. Ligger kvar tills den
// accepteras eller aterkallas; raderas aldrig av appen.
model inbjudan {
  id          String            @id @default(uuid()) @db.Uuid
  bostad_id   String            @db.Uuid
  epost       String // gemener, trimmad – jamfors mot inloggad adress i gemener
  inbjuden_av String?           @db.Uuid // null nar den som bjod in raderat sitt konto
  // Den inbjudnas agarandel i procent, satt av den som bjod in. Blir
  // medlemskapets andel nar inbjudan loses in. Ett utgangsvarde, inte ett
  // facit – det bekraftas nar bostaden markeras som sald. Null for
  // inbjudningar skapade innan andelen fragades; de ger da standardvardet.
  agarandel   Decimal?          @db.Decimal(5, 2)
  status      inbjudningsstatus @default(utestaende)
  besvarad_at DateTime? // nar den accepterades eller aterkallades
  skapad_at   DateTime          @default(now())

  bostad    bostad     @relation(fields: [bostad_id], references: [id], onDelete: Cascade)
  inbjudare anvandare? @relation(fields: [inbjuden_av], references: [id], onDelete: SetNull)

  @@index([epost, status])
  @@index([bostad_id, status])
}

// Skattereglernas numeriska varden med giltighetsperiod. Aldrig konstanter i koden.
model regelparameter {
  id          String              @id @default(uuid()) @db.Uuid
  nyckel      String // t.ex. troskelbelopp, reparationsfonster_ar
  varde       Int
  enhet       regelparameterenhet
  giltig_fran DateTime            @db.Date
  giltig_till DateTime?           @db.Date // null = tills vidare
  kalla       String?

  @@index([nyckel, giltig_fran])
}

// Klassificeringen sitter har, inte pa kostnaden. Fragetradet (produktspec 4.1,
// CLAUDE.md): atgardstyp/battre_kvalitet/merkostnad ar svaren pa fraga 2-5,
// skick_forvarv/skick_forsaljning pa fraga 6-7, motivering pa fraga 8.
model projekt {
  id                String      @id @default(uuid()) @db.Uuid
  bostad_id         String      @db.Uuid
  namn              String // fraga 1, fritext
  ar                Int // etikett for gruppering; auktoritativt ar kommer fran betaldatum
  atgardstyp        atgardstyp? // fraga 2-4; null tills klassificeringsgenomgangens fas 2 svarat
  battre_kvalitet   Boolean? // fraga 5, endast relevant nar atgardstyp = utbytt
  merkostnad        Int? // oren, obligatorisk och > 0 nar battre_kvalitet = true
  skick_forvarv     Int? // fraga 6, 0-5, stalls bara nar atgarden har en reparationsdel
  skick_forsaljning Int? // fraga 7, 0-5, null fram till forsaljningen
  motivering        String? // fraga 8, "hur vet du det?" – fritext, valfri, bar bevisningen
  // Vem som senast besvarade fragetradet (fas 2 eller redigeringen). Bara for
  // raden "Besvarat av" nar bostaden har fler an en medlem. Null for aldre
  // svar och nar personen raderat sitt konto – raden uteblir da, den gissar inte.
  klassificerad_av  String?     @db.Uuid
  skapad_at         DateTime    @default(now())

  bostad         bostad          @relation(fields: [bostad_id], references: [id], onDelete: Cascade)
  klassificerare anvandare?      @relation("projekt_klassificerad_av", fields: [klassificerad_av], references: [id], onDelete: SetNull)
  fordelningar   radfordelning[]
}

// Ett kvitto eller en faktura. Tillstand (obetald/okopplad/kopplad) harleds, lagras inte.
model kostnad {
  id                    String    @id @default(uuid()) @db.Uuid
  bostad_id             String    @db.Uuid
  leverantor            String? // null bara for utkast (se totalbelopp)
  totalbelopp           Int? // oren. null = UTKAST: kvittot valt och uppladdat men uppgifterna inte ifyllda an. Raknas inte in nagonstans, rensas aldrig automatiskt.
  dokumentdatum         DateTime? @db.Date // null bara for utkast
  betaldatum            DateTime? @db.Date // null = obetald, raknas inte in
  rot_utnyttjat         Int? // oren, dras bort fran underlaget; anges i kronor, aldrig i procent
  forsakringsersattning Int? // oren, dras bort fran underlaget
  arkiverad             Boolean   @default(false)
  anteckning            String? // "Vad gallde det?" – valfri fritext, bar minnet till klassificeringen (produktspec 2b)
  // Vem som lade in kvittot. Bara for raden "Tillagt av" nar bostaden har fler
  // an en medlem. Null for aldre kvitton och nar personen raderat sitt konto –
  // raden uteblir da, den gissar inte.
  skapad_av             String?   @db.Uuid
  skapad_at             DateTime  @default(now())

  bostad  bostad        @relation(fields: [bostad_id], references: [id], onDelete: Cascade)
  skapare anvandare?    @relation("kostnad_skapad_av", fields: [skapad_av], references: [id], onDelete: SetNull)
  rader   kostnadsrad[]
  bilagor bilaga[]
}

// En rad pa kvittot. Summan av radernas belopp ska alltid vara lika med totalbelopp.
model kostnadsrad {
  id         String @id @default(uuid()) @db.Uuid
  kostnad_id String @db.Uuid
  artikel    String
  belopp     Int // oren

  kostnad      kostnad         @relation(fields: [kostnad_id], references: [id], onDelete: Cascade)
  fordelningar radfordelning[]
}

// Fordelning av en rad till ett projekt eller till privat. Andelarna far summera
// till mindre an 1 – resten ligger kvar som okopplat. Antingen privat=true och
// projekt_id=null, eller privat=false och projekt_id satt (valideras i appen).
model radfordelning {
  id             String  @id @default(uuid()) @db.Uuid
  kostnadsrad_id String  @db.Uuid
  projekt_id     String? @db.Uuid
  privat         Boolean @default(false)
  andel          Decimal @db.Decimal(5, 4) // 0..1

  kostnadsrad kostnadsrad @relation(fields: [kostnadsrad_id], references: [id], onDelete: Cascade)
  projekt     projekt?    @relation(fields: [projekt_id], references: [id], onDelete: Cascade)

  @@index([projekt_id])
}

// Permanent arkiv: kvittobild/PDF och betalningsunderlag. Uppladdning bekraftas
// alltid innan flodet gar vidare – uppladdning_bekraftad satts nar servern svarat.
model bilaga {
  id                    String   @id @default(uuid()) @db.Uuid
  kostnad_id            String?  @db.Uuid
  lagringsnyckel        String   @unique // sokvag till originalet i Supabase Storage
  miniatyrnyckel        String?  @unique // JPG-miniatyr for HEIC; null for format som redan gar att visa
  visningsnyckel        String?  @unique // JPG, langsta sidan ~2000px, for helskarm/PDF-paket; null for PDF och nar konverteringen inte kunnat goras
  filnamn               String
  mimetyp               String
  storlek               Int // bytes
  uppladdning_bekraftad Boolean  @default(false)
  // Dokumentavlasningen kors en gang per bilaga. Satts nar sprakmodellanropet
  // gjorts – oavsett utfall – sa att ett aterupptaget utkast hoppar over
  // avlasningen och visar sina redan sparade varden direkt.
  dokument_analyserad   Boolean  @default(false)
  // Flersidiga PDF:er (docs/design.md, "Bilagor"). Sidantalet lases ur PDF:ens
  // sidtrad vid uppladdningen (ingen rendering, se src/lib/lagring/pdf-sidor.ts) –
  // sjalva sidorna renderas i webblasaren (src/lib/pdfjs-klient.ts) och lagras
  // aldrig i Storage. Null for bilder, och for PDF:er dar rakningen inte
  // gjorts an (aldre bilagor fore backfillen) eller misslyckades (trasig PDF).
  sidantal              Int?
  // Bildens mått i pixlar, lästa vid uppladdningen medan filen ändå finns i
  // minnet for miniatyr-/visningskonverteringen (docs/produktspec.md,
  // "PDF-sidor renderas i webbläsaren"). Anvands for att reservera ratt yta
  // at forhandsvisningen INNAN filen hamtats, sa inget hoppar nar bilden
  // landar. For en PDF ar det forsta sidans matt, laset i samma steg som
  // sidantalet. Null for aldre bilagor fore backfillen (se
  // scripts/fyll-pa-bilaga-matt.ts) eller nar matten inte gick att lasa.
  bredd                 Int?
  hojd                  Int?
  skapad_at             DateTime @default(now())

  kostnad kostnad? @relation(fields: [kostnad_id], references: [id], onDelete: Cascade)
}
