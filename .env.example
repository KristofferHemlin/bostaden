# Supabase Postgres. Kopiera till .env och byt ut mot projektets varden.

# Poolad anslutning for appen (PgBouncer, port 6543):
DATABASE_URL="postgresql://postgres.PROJEKTREF:LOSENORD@aws-0-eu-north-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direkt anslutning for migrationer och seed (port 5432):
DIRECT_URL="postgresql://postgres.PROJEKTREF:LOSENORD@aws-0-eu-north-1.pooler.supabase.com:5432/postgres"

# Supabase Auth for klienten. URL ar https://PROJEKTREF.supabase.co.
# Nyckeln finns i dashboarden under Project Settings > API. Satt EN av dessa:
#   - NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY  (nyare projekt, borjar med sb_publishable_)
#   - NEXT_PUBLIC_SUPABASE_ANON_KEY         (aldre projekt, en publik JWT)
# Bada godtas; publishable-nyckeln har foretrade om bada ar satta.
NEXT_PUBLIC_SUPABASE_URL="https://PROJEKTREF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
