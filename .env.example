# Supabase Postgres. Kopiera till .env och byt ut mot projektets varden.

# Poolad anslutning for appen (PgBouncer, port 6543):
DATABASE_URL="postgresql://postgres.PROJEKTREF:LOSENORD@aws-0-eu-north-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direkt anslutning for migrationer och seed (port 5432):
DIRECT_URL="postgresql://postgres.PROJEKTREF:LOSENORD@aws-0-eu-north-1.pooler.supabase.com:5432/postgres"

# Supabase Auth for klienten. URL ar https://PROJEKTREF.supabase.co.
# Nyckeln finns i dashboarden under Project Settings > API. Satt EN av dessa:
#   - NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY  (nyare projekt, borjar med sb_publishable_)
#   - NEXT_PUBLIC_SUPABASE_ANON_KEY         (aldre projekt, en publik JWT)
# Bada godtas; publishable-nyckeln har foretrade om bada ar satta.
NEXT_PUBLIC_SUPABASE_URL="https://PROJEKTREF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Service role-nyckel for fillagringen (Supabase Storage). ENDAST server – far
# ALDRIG ha NEXT_PUBLIC_-prefix och aldrig hamna i klientbunten. Bilagorna ar
# kvitton och fakturor: bucketen ar privat, atkomst sker via korta signerade
# URL:er som servern skapar efter behorighetskontroll mot medlemskapet.
# Kor "npm run lagring:setup" en gang for att skapa den privata bucketen.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# Valfri. Anthropic API-nyckel for dokumentavlasningen (produktspec avsnitt 9).
# Nar en bilaga valts i kostnadsformularet skickas den till en sprakmodell som
# laser ut datum, totalbelopp och leverantor. ENDAST server – far ALDRIG ha
# NEXT_PUBLIC_-prefix. Saknas nyckeln hoppas avlasningen over helt: inga
# felmeddelanden, formularet fungerar precis som vanligt.
ANTHROPIC_API_KEY=""

# Valfri. Google Places (New) API-nyckel for adressforslagen i registreringen.
# Saknas den ar adressfaltet ett vanligt textfalt utan forslag – inget fel, ingen
# blockering. Nyckeln behover "Places API (New)" aktiverat och ligger i klienten,
# sa begransa den till din doman i Google Cloud Console.
NEXT_PUBLIC_GOOGLE_PLACES_KEY=""

# Felrapportering (produktspec avsnitt 13). Valfritt precis som ovan – saknas
# DSN:en initieras Sentry aldrig, och appen fungerar exakt som utan
# felrapportering. DSN:en far vara NEXT_PUBLIC_ – den later klienten SKICKA
# handelser, aldrig lasa nagot, och racker for bade server, edge och klient
# (se sentry.server.config.ts, sentry.edge.config.ts, src/instrumentation-client.ts).
# Filtreringen som ser till att inga kvittobilder, belopp, leverantorer,
# adresser eller filnamn nar Sentry star i src/lib/sentry-filter.ts.
NEXT_PUBLIC_SENTRY_DSN=""

# Valfria, ENDAST for kallkodsuppladdning vid bygge (lasbara stacktraces i
# Sentry i stallet for minifierad kod). Saknas SENTRY_AUTH_TOKEN hoppar
# byggpluginet bara over det steget – bygget gar igenom som vanligt. Org och
# projekt-slug hittas i Sentrys dashboard-URL; token skapas under
# Settings > Auth Tokens med scopet "project:releases".
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
