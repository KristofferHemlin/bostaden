# Supabase Postgres. Kopiera till .env och byt ut mot projektets varden.

# Poolad anslutning for appen (PgBouncer, port 6543):
DATABASE_URL="postgresql://postgres.PROJEKTREF:LOSENORD@aws-0-eu-north-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direkt anslutning for migrationer och seed (port 5432):
DIRECT_URL="postgresql://postgres.PROJEKTREF:LOSENORD@aws-0-eu-north-1.pooler.supabase.com:5432/postgres"
